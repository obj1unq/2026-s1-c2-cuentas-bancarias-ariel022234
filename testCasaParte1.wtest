import casa.*
import cuentas.*


describe "reparaciones y viveres" {

  test "reparaciones y viveres" {
    casa.setViveres(30)
    casa.setCuenta(cuentaCorriente)
    cuentaCorriente.depositar(2000)
    casa.romper(1000)
    assert.notThat(casa.hayViveresSuficientes())
    assert.that(casa.hayQueHacerReparaciones())
    assert.notThat(casa.casaEnOrden())
    assert.throwsException({casa.comprarViveres(80,2)})
    assert.equals(30, casa.viveres())
    assert.equals(2000, cuentaCorriente.saldo())
    assert.equals(0, casa.gastosTotales())
    casa.comprarViveres(20, 2)
    assert.that(casa.hayViveresSuficientes())  
    assert.equals(50, casa.viveres())
    assert.notThat(casa.casaEnOrden())
    assert.equals(1960, cuentaCorriente.saldo())
    assert.equals(40, casa.gastosTotales())
    casa.reparar()
    assert.notThat(casa.hayQueHacerReparaciones())
    assert.equals(960, cuentaCorriente.saldo())
    assert.equals(1040, casa.gastosTotales())

    

    
  }

}

